# Server Configuration
PORT=9000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net
# Optional: override default db name from the URI
MONGODB_DB_NAME=balwinder

# Firebase Configuration
# Get your service account JSON from Firebase Console:
# 1. Go to Firebase Console > Project Settings > Service Accounts
# 2. Click "Generate New Private Key"
# 3. Copy the entire JSON content and paste it as a single line string below
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Firebase Project ID (same as in service account)
FIREBASE_PROJECT_ID=your-project-id


# Contact form email notifications (nodemailer)
# For Google Workspace / Gmail: smtp.gmail.com:587 (or 465 with SMTP_SECURE=true)
# For cPanel hosting: often mail.yourdomain.com or smtp.yourdomain.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=admin@bndcreation.com
SMTP_PASS=your-smtp-password-or-app-password
SMTP_FROM=admin@bndcreation.com
# Where contact form submissions are delivered
ADMIN_NOTIFY_EMAIL=Bndcreation1234@gmail.com
